{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // O pacote compartilhado (@ff-resources/ui) é uma junction em node_modules
    // (dep file:). Os paths apontam POR ELA + preserveSymlinks: assim os
    // arquivos do shared ficam dentro da cadeia de node_modules do app e o tsc
    // acha as dependências deles (radix-ui, @tiptap, lucide-react...). Apontar
    // direto para frontend/shared tira os arquivos dessa cadeia e estoura
    // "cannot find module" nos pacotes.
    "preserveSymlinks": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/bindings/*": ["./bindings/*"],
      "@ff13-bindings/*": ["./bindings-ff13/*"],
      "next-themes": ["./node_modules/@ff-resources/ui/src/theme.tsx"],
      "@ff-resources/ui": ["./node_modules/@ff-resources/ui/src/index.ts"],
      "@ff-resources/ui/*": ["./node_modules/@ff-resources/ui/src/*"],
      "@/components/ui/*": ["./node_modules/@ff-resources/ui/src/components/ui/*"],
      "@/components/editor/*": ["./node_modules/@ff-resources/ui/src/editor/*"],
      "@/components/game-text-view": ["./node_modules/@ff-resources/ui/src/components/game-text-view.tsx"],
      "@/components/progress/progress-modal": ["./node_modules/@ff-resources/ui/src/components/progress/progress-modal.tsx"],
      "@/components/entry-view/entry-table/entry-table-empty": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/entry-table-empty.tsx"],
      "@/components/entry-view/content-tree/search-control": ["./node_modules/@ff-resources/ui/src/components/entry-view/content-tree/search-control.tsx"],
      "@/components/entry-view/content-tree/tree-context": ["./node_modules/@ff-resources/ui/src/components/entry-view/content-tree/tree-context.tsx"],
      "@/components/entry-view/content-tree/tree-item": ["./node_modules/@ff-resources/ui/src/components/entry-view/content-tree/tree-item.tsx"],
      "@/components/entry-view/content-tree/tree-list": ["./node_modules/@ff-resources/ui/src/components/entry-view/content-tree/tree-list.tsx"],
      "@/components/entry-view/image-panel/use-image-preview": ["./node_modules/@ff-resources/ui/src/components/entry-view/image-panel/use-image-preview.ts"],
      "@/components/entry-view/image-panel/image-preview": ["./node_modules/@ff-resources/ui/src/components/entry-view/image-panel/image-preview.tsx"],
      "@/lib/utils": ["./node_modules/@ff-resources/ui/src/lib/utils.ts"],
      "@/lib/ffx/game-text-parser": ["./node_modules/@ff-resources/ui/src/editor/game-text-parser.ts"],
      "@/lib/ffx/game-text-format": ["./node_modules/@ff-resources/ui/src/editor/game-text-format.ts"],
      "@/lib/ffx/game-text-tags": ["./node_modules/@ff-resources/ui/src/editor/game-text-tags.ts"],
      "@/lib/ffx/plain-text": ["./node_modules/@ff-resources/ui/src/editor/plain-text.ts"],
      "@/lib/ffx/find-in-text": ["./node_modules/@ff-resources/ui/src/editor/find-in-text.ts"],
      "@/lib/ffx/protected-tags": ["./node_modules/@ff-resources/ui/src/editor/protected-tags.ts"],
      "@/lib/ffx/leading-padding": ["./node_modules/@ff-resources/ui/src/editor/leading-padding.ts"],
      "@/lib/ffx/blank-us": ["./node_modules/@ff-resources/ui/src/editor/blank-us.ts"],
      "@/lib/ffx/bytes": ["./node_modules/@ff-resources/ui/src/editor/bytes.ts"],
      "@/lib/ffx/clipboard": ["./node_modules/@ff-resources/ui/src/editor/clipboard.ts"],
      "@/lib/ffx/tag-catalog": ["./node_modules/@ff-resources/ui/src/editor/tag-catalog.ts"],
      "@/lib/ffx/statusbar-store": ["./node_modules/@ff-resources/ui/src/app/statusbar-store.ts"],
      "@/lib/ffx/progress-store": ["./node_modules/@ff-resources/ui/src/app/progress-store.ts"],
      "@/lib/ffx/use-wails-event": ["./node_modules/@ff-resources/ui/src/app/use-wails-event.ts"],
      "@/lib/ffx/shortcuts": ["./node_modules/@ff-resources/ui/src/app/shortcuts.ts"],
      "@/lib/ffx/layout-storage": ["./node_modules/@ff-resources/ui/src/app/layout-storage.ts"],
      "@/lib/ffx/tab-storage": ["./node_modules/@ff-resources/ui/src/app/tab-storage.ts"],
      "@/lib/ffx/use-persisted-layout": ["./node_modules/@ff-resources/ui/src/app/use-persisted-layout.ts"],
      "@/lib/ffx/error-handler": ["./node_modules/@ff-resources/ui/src/app/error-handler.ts"],
      "@/lib/ffx/hash-ref": ["./node_modules/@ff-resources/ui/src/app/hash-ref.ts"],
      "@/lib/ffx/find-store": ["./node_modules/@ff-resources/ui/src/app/find-store.ts"],
      "@/lib/ffx/display-names": ["./node_modules/@ff-resources/ui/src/app/display-names.ts"],
      "@/lib/ffx/content-tree/model": ["./node_modules/@ff-resources/ui/src/app/content-tree/model.ts"],
      "@/lib/ffx/vbf-selection": ["./node_modules/@ff-resources/ui/src/app/vbf-selection.ts"],
      "@/lib/ffx/tree-data": ["./node_modules/@ff-resources/ui/src/app/tree-data.ts"],
      "@/lib/ffx/export-selection": ["./node_modules/@ff-resources/ui/src/app/export-selection.ts"],
      "@/lib/ffx/toast-logged": ["./node_modules/@ff-resources/ui/src/app/toast-logged.ts"],
      "@/lib/ffx/prune-confirm-store": ["./node_modules/@ff-resources/ui/src/app/prune-confirm-store.ts"],
      "@/lib/ffx/edit-draft": ["./node_modules/@ff-resources/ui/src/app/edit-draft.ts"],
      "@/lib/ffx/save-all": ["./node_modules/@ff-resources/ui/src/app/save-all.ts"],
      "@/lib/ffx/entry-progress": ["./node_modules/@ff-resources/ui/src/app/entry-progress.ts"],
      "@/components/entry-view/entry-table/table-types": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/table-types.ts"],
      "@/components/entry-view/entry-table/entry-table-header": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/entry-table-header.tsx"],
      "@/components/entry-view/entry-table/entry-table-body": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/entry-table-body.tsx"],
      "@/components/entry-view/entry-table/table-bar": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/table-bar.tsx"],
      "@/components/entry-view/entry-table/columns/editable-cell": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/columns/editable-cell.tsx"],
      "@/components/entry-view/entry-table/columns/index-column": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/columns/index-column.tsx"],
      "@/components/entry-view/entry-table/columns/linked-cell": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/columns/linked-cell.tsx"],
      "@/components/entry-view/entry-table/columns/name-column": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/columns/name-column.tsx"],
      "@/components/entry-view/entry-table/columns/original-column": ["./node_modules/@ff-resources/ui/src/components/entry-view/entry-table/columns/original-column.tsx"]
    }
  },
  "include": ["src", "bindings", "bindings-ff13", "vite.config.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
