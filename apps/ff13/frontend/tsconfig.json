{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/bindings/*": ["./bindings/*"],
      "@ff13-bindings/*": ["./bindings-ff13/*"],
      "@ff-resources/ui": ["../../frontend/shared/src/index.ts"],
      "@ff-resources/ui/*": ["../../frontend/shared/src/*"],
      "@/components/ui/*": ["../../frontend/shared/src/components/ui/*"],
      "@/components/editor/*": ["../../frontend/shared/src/editor/*"],
      "@/components/game-text-view": ["../../frontend/shared/src/components/game-text-view.tsx"],
      "@/components/progress/progress-modal": ["../../frontend/shared/src/components/progress/progress-modal.tsx"],
      "@/components/entry-view/entry-table/entry-table-empty": ["../../frontend/shared/src/components/entry-view/entry-table/entry-table-empty.tsx"],
      "@/components/entry-view/content-tree/search-control": ["../../frontend/shared/src/components/entry-view/content-tree/search-control.tsx"],
      "@/components/entry-view/content-tree/tree-context": ["../../frontend/shared/src/components/entry-view/content-tree/tree-context.tsx"],
      "@/components/entry-view/content-tree/tree-item": ["../../frontend/shared/src/components/entry-view/content-tree/tree-item.tsx"],
      "@/components/entry-view/content-tree/tree-list": ["../../frontend/shared/src/components/entry-view/content-tree/tree-list.tsx"],
      "@/components/entry-view/image-panel/use-image-preview": ["../../frontend/shared/src/components/entry-view/image-panel/use-image-preview.ts"],
      "@/components/entry-view/image-panel/image-preview": ["../../frontend/shared/src/components/entry-view/image-panel/image-preview.tsx"],
      "@/lib/utils": ["../../frontend/shared/src/lib/utils.ts"],
      "@/lib/ffx/game-text-parser": ["../../frontend/shared/src/editor/game-text-parser.ts"],
      "@/lib/ffx/game-text-format": ["../../frontend/shared/src/editor/game-text-format.ts"],
      "@/lib/ffx/game-text-tags": ["../../frontend/shared/src/editor/game-text-tags.ts"],
      "@/lib/ffx/plain-text": ["../../frontend/shared/src/editor/plain-text.ts"],
      "@/lib/ffx/find-in-text": ["../../frontend/shared/src/editor/find-in-text.ts"],
      "@/lib/ffx/protected-tags": ["../../frontend/shared/src/editor/protected-tags.ts"],
      "@/lib/ffx/leading-padding": ["../../frontend/shared/src/editor/leading-padding.ts"],
      "@/lib/ffx/blank-us": ["../../frontend/shared/src/editor/blank-us.ts"],
      "@/lib/ffx/bytes": ["../../frontend/shared/src/editor/bytes.ts"],
      "@/lib/ffx/clipboard": ["../../frontend/shared/src/editor/clipboard.ts"],
      "@/lib/ffx/tag-catalog": ["../../frontend/shared/src/editor/tag-catalog.ts"],
      "@/lib/ffx/statusbar-store": ["../../frontend/shared/src/app/statusbar-store.ts"],
      "@/lib/ffx/progress-store": ["../../frontend/shared/src/app/progress-store.ts"],
      "@/lib/ffx/use-wails-event": ["../../frontend/shared/src/app/use-wails-event.ts"],
      "@/lib/ffx/shortcuts": ["../../frontend/shared/src/app/shortcuts.ts"],
      "@/lib/ffx/layout-storage": ["../../frontend/shared/src/app/layout-storage.ts"],
      "@/lib/ffx/tab-storage": ["../../frontend/shared/src/app/tab-storage.ts"],
      "@/lib/ffx/use-persisted-layout": ["../../frontend/shared/src/app/use-persisted-layout.ts"],
      "@/lib/ffx/error-handler": ["../../frontend/shared/src/app/error-handler.ts"],
      "@/lib/ffx/hash-ref": ["../../frontend/shared/src/app/hash-ref.ts"],
      "@/lib/ffx/find-store": ["../../frontend/shared/src/app/find-store.ts"],
      "@/lib/ffx/display-names": ["../../frontend/shared/src/app/display-names.ts"],
      "@/lib/ffx/content-tree/model": ["../../frontend/shared/src/app/content-tree/model.ts"],
      "@/lib/ffx/vbf-selection": ["../../frontend/shared/src/app/vbf-selection.ts"],
      "@/lib/ffx/tree-data": ["../../frontend/shared/src/app/tree-data.ts"],
      "@/lib/ffx/export-selection": ["../../frontend/shared/src/app/export-selection.ts"],
      "@/lib/ffx/toast-logged": ["../../frontend/shared/src/app/toast-logged.ts"],
      "@/lib/ffx/prune-confirm-store": ["../../frontend/shared/src/app/prune-confirm-store.ts"],
      "@/lib/ffx/edit-draft": ["../../frontend/shared/src/app/edit-draft.ts"],
      "@/lib/ffx/save-all": ["../../frontend/shared/src/app/save-all.ts"],
      "@/lib/ffx/entry-progress": ["../../frontend/shared/src/app/entry-progress.ts"],
      "@/components/entry-view/entry-table/table-types": ["../../frontend/shared/src/components/entry-view/entry-table/table-types.ts"],
      "@/components/entry-view/entry-table/entry-table-header": ["../../frontend/shared/src/components/entry-view/entry-table/entry-table-header.tsx"],
      "@/components/entry-view/entry-table/entry-table-body": ["../../frontend/shared/src/components/entry-view/entry-table/entry-table-body.tsx"],
      "@/components/entry-view/entry-table/table-bar": ["../../frontend/shared/src/components/entry-view/entry-table/table-bar.tsx"],
      "@/components/entry-view/entry-table/columns/editable-cell": ["../../frontend/shared/src/components/entry-view/entry-table/columns/editable-cell.tsx"],
      "@/components/entry-view/entry-table/columns/index-column": ["../../frontend/shared/src/components/entry-view/entry-table/columns/index-column.tsx"],
      "@/components/entry-view/entry-table/columns/linked-cell": ["../../frontend/shared/src/components/entry-view/entry-table/columns/linked-cell.tsx"],
      "@/components/entry-view/entry-table/columns/name-column": ["../../frontend/shared/src/components/entry-view/entry-table/columns/name-column.tsx"],
      "@/components/entry-view/entry-table/columns/original-column": ["../../frontend/shared/src/components/entry-view/entry-table/columns/original-column.tsx"]
    }
  },
  "include": ["src", "bindings", "bindings-ff13", "vite.config.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
